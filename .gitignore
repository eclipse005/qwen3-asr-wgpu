# CUDA golden dumps + torch reference dumps (1.5 GB; regenerate — see src/golden.rs)
/golden/

# runtime debug dumps (regenerated on every prefill_check run)
/*.bin

# local build output
/target/
/cuda_ref/target/

# probe dump bins (regenerable via src/bin/exp_probe.rs)
exp_probe/*.bin

# Command Code session state (taste memory, session logs)
/.commandcode/

# bench harness output (regenerate with scripts/bench.ps1)
/scripts/bench-*.tsv
/scripts/*.log

# the measured-performance docs -- this machine's numbers, kept out of the
# published tree (they live on disk; the history they were in was never pushed)
/docs/
/HANDOFF.md

# python bytecode from the eval drivers
/scripts/__pycache__/
